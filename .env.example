# BeeHub environment. Copy to .env and fill in. NEVER commit .env (spec §7).

# --- Anthropic ---
# The SDK also accepts an `ant auth login` profile; this var takes precedence.
ANTHROPIC_API_KEY=sk-ant-...

# --- Embeddings (Voyage) ---
# voyage-4-lite @ 1024 dims. 200M free tokens covers all of Phase 1.
VOYAGE_API_KEY=pa-...

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Anon key: used by the frontend and by per-request backend clients carrying the user's JWT.
SUPABASE_ANON_KEY=eyJ...
# Service role: ingestion worker ONLY. Bypasses RLS — never use in a request handler.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Direct Postgres connection, for migrations and the worker's job-queue polling.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Set true in dev to re-read skills/ on each request. Must stay false in prod:
# a mid-request skill change breaks the cached prefix and yields two different
# results recorded under one prompt_hash.
RELOAD_SKILLS=false

# --- Frontend (apps/web, Vite: only VITE_* is exposed to the browser) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_API_BASE_URL=http://localhost:8000
